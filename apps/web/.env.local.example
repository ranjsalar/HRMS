# Copy to .env.local (gitignored). Points at the API dev server started
# via `pnpm --filter @hrms/api dev` (apps/api's own .env, port 3001).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional — leave unset to keep error monitoring inactive (a genuine
# no-op). NEXT_PUBLIC_ prefix required: this gets inlined into the
# client bundle at build time, same as NEXT_PUBLIC_API_URL above. See
# DECISIONS.md ("Infrastructure pass, item 6").
# NEXT_PUBLIC_SENTRY_DSN=
