# Template for apps/api/.env.production — created ONCE, directly on the
# production VPS, gitignored, never committed (same convention as .env
# and .env.test). Read by ConfigModule when NODE_ENV=production (see
# env.validation.ts's resolveEnvFilePath and DECISIONS.md, "Config
# hygiene"). Hostnames below assume the production Docker Compose setup
# (item 3 of the infrastructure pass) runs Postgres/Redis as
# docker-compose services named `postgres`/`redis`, matching the ROOT
# .env.example's existing convention — adjust if that topology changes.
#
# GENERATING SECRETS: run `pnpm --filter @hrms/api
# cli:generate-production-secrets` and paste its output over the
# corresponding lines below. Every secret it produces is freshly random
# on every run — NEVER copy values from .env/.env.test/.env.example into
# a real production file. A shared secret across environments means a
# leak in one compromises all of them. See DECISIONS.md.

NODE_ENV=production
PORT=3001

# ── Database (docker-compose service networking — see DECISIONS.md,
# "Postgres role separation for RLS to have teeth" for what each role is
# for) ──
DATABASE_MIGRATE_URL=postgresql://hrms:GENERATE_ME@postgres:5432/hrms?schema=public
DATABASE_URL=postgresql://hrms_app:GENERATE_ME@postgres:5432/hrms?schema=public
DATABASE_SUPERADMIN_URL=postgresql://hrms_superadmin:GENERATE_ME@postgres:5432/hrms?schema=public
DATABASE_AUTH_URL=postgresql://hrms_auth:GENERATE_ME@postgres:5432/hrms?schema=public

# Passwords used ONCE by `pnpm --filter @hrms/api db:bootstrap-roles`
# after migrating, to set the three roles above — must match whatever
# you put in the DATABASE_*_URL lines above.
HRMS_APP_DB_PASSWORD=GENERATE_ME
HRMS_SUPERADMIN_DB_PASSWORD=GENERATE_ME
HRMS_AUTH_DB_PASSWORD=GENERATE_ME

REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=GENERATE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PASSWORD_RESET_SECRET=GENERATE_ME
PASSWORD_RESET_TTL=30m

TWO_FACTOR_PENDING_SECRET=GENERATE_ME
TWO_FACTOR_PENDING_TTL=5m

TOTP_ISSUER=HRMS

# AES-256-GCM field encryption key — must be a real base64-encoded
# 32-byte value (the generator script produces one correctly; do not
# hand-type this one). Back it up somewhere safe outside of git the
# moment you generate it — rotating it after real data has been
# encrypted makes that data unreadable.
FIELD_ENCRYPTION_KEY=GENERATE_ME

DOCUMENT_STORAGE_PATH=../../storage/documents
DOCUMENT_URL_SECRET=GENERATE_ME
DOCUMENT_URL_TTL=10m

PAYSLIP_STORAGE_PATH=../../storage/payslips
PAYSLIP_URL_SECRET=GENERATE_ME
PAYSLIP_URL_TTL=10m

# Real deployment values, not generated — fill in by hand once the
# domain/DNS exists (infrastructure pass items 3-4).
CORS_ORIGINS=https://REPLACE_WITH_REAL_DOMAIN
FRONTEND_URL=https://REPLACE_WITH_REAL_DOMAIN

# Production-appropriate defaults — do NOT copy dev's higher
# AUTH_LOGIN_RATE_LIMIT/AUTH_STRICT_RATE_LIMIT values here. See
# DECISIONS.md ("Rate limiting on auth endpoints").
AUTH_LOGIN_RATE_LIMIT=10
AUTH_STRICT_RATE_LIMIT=5

# Real SMTP provider credentials (Resend/Postmark/SES/Brevo/etc) — not
# generated, and not MailDev. See DECISIONS.md ("Real password-reset
# email delivery").
SMTP_HOST=REPLACE_WITH_REAL_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
EMAIL_FROM=HRMS <no-reply@REPLACE_WITH_REAL_DOMAIN>
