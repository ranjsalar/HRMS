# Template for apps/api/.env.test (gitignored, not committed — same pattern
# as .env / .env.example at the repo root). Copy this to .env.test and fill
# in real values for your local dev Postgres container.
#
# PrismaService / PrismaSuperAdminService / PrismaAuthService all connect at
# Nest bootstrap, so these must point at a reachable Postgres. There is no
# isolated test database yet — pointing at the same dev container as
# apps/api/.env is fine while e2e tests don't need strict isolation from
# dev data; get a dedicated test database if that changes.
NODE_ENV=test
# Regression-test canary (test/env-isolation.e2e-spec.ts). See DECISIONS.md.
ENV_ISOLATION_CANARY=test-value
DATABASE_URL=postgresql://hrms_app:REPLACE_ME@localhost:5433/hrms?schema=public
DATABASE_SUPERADMIN_URL=postgresql://hrms_superadmin:REPLACE_ME@localhost:5433/hrms?schema=public
DATABASE_AUTH_URL=postgresql://hrms_auth:REPLACE_ME@localhost:5433/hrms?schema=public
# DB index 1, not the default 0 apps/api/.env uses — keeps the e2e
# suite's BullMQ queues (payroll PDF generation) isolated from a real dev
# API server that might be running concurrently. See DECISIONS.md.
REDIS_URL=redis://localhost:6379/1
JWT_ACCESS_SECRET=test_access_secret_at_least_32_characters
PASSWORD_RESET_SECRET=test_password_reset_secret_at_least_32_chars
PASSWORD_RESET_TTL=30m
TWO_FACTOR_PENDING_SECRET=test_two_factor_pending_secret_at_least_32ch
TWO_FACTOR_PENDING_TTL=5m
TOTP_ISSUER=HRMS-Test
# Must actually be a valid base64-encoded 32-byte key, not just a
# 32+ character string — the auth/employees e2e tests genuinely
# encrypt/decrypt through this. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace_with_a_real_base64_32byte_key
DOCUMENT_STORAGE_PATH=../../storage/documents-test
DOCUMENT_URL_SECRET=test_document_url_secret_at_least_32_characters
DOCUMENT_URL_TTL=10m
PAYSLIP_STORAGE_PATH=../../storage/payslips-test
PAYSLIP_URL_SECRET=test_payslip_url_secret_at_least_32_characters
PAYSLIP_URL_TTL=10m
CORS_ORIGINS=http://localhost:3000
# Explicit, matching the production-appropriate defaults — see
# DECISIONS.md for why this must be set here explicitly rather than left
# to the schema default (ConfigModule falls through to apps/api/.env for
# any var this file doesn't set).
AUTH_LOGIN_RATE_LIMIT=10
AUTH_STRICT_RATE_LIMIT=5
GENERAL_API_RATE_LIMIT=1000
FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=HRMS Test <no-reply@hrms.test>
