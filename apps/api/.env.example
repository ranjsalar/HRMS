# Template for apps/api/.env (gitignored, not committed). Used by the
# Prisma CLI and seed scripts (bootstrap-roles.ts, seed.ts, verify-rls.ts)
# run directly on the host, outside Docker — hence `localhost`, not the
# `postgres`/`redis` service names the root .env.example uses. Same roles
# and secrets as the root .env; see DECISIONS.md ("Postgres role separation
# for RLS to have teeth").
#
# Host port 5433 (not 5432) because docker-compose.yml publishes Postgres
# there — 5432 may already be taken by a native Postgres install on your
# machine (it was on the one this project started on). If you don't have
# that conflict, you can remap docker-compose.yml back to 5432:5432 and
# adjust these URLs to match.

NODE_ENV=development
PORT=3001

# Regression-test canary (test/env-isolation.e2e-spec.ts) — also in
# .env.test.example with a DIFFERENT value. See DECISIONS.md.
ENV_ISOLATION_CANARY=dev-value

DATABASE_MIGRATE_URL=postgresql://hrms:hrms_dev_password@localhost:5433/hrms?schema=public
DATABASE_URL=postgresql://hrms_app:hrms_app_dev_password@localhost:5433/hrms?schema=public
DATABASE_SUPERADMIN_URL=postgresql://hrms_superadmin:hrms_superadmin_dev_password@localhost:5433/hrms?schema=public
DATABASE_AUTH_URL=postgresql://hrms_auth:hrms_auth_dev_password@localhost:5433/hrms?schema=public

HRMS_APP_DB_PASSWORD=hrms_app_dev_password
HRMS_SUPERADMIN_DB_PASSWORD=hrms_superadmin_dev_password
HRMS_AUTH_DB_PASSWORD=hrms_auth_dev_password

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_random_32plus_char_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Generate with: openssl rand -base64 48
PASSWORD_RESET_SECRET=replace_with_a_random_32plus_char_secret
PASSWORD_RESET_TTL=30m

# Generate with: openssl rand -base64 48
TWO_FACTOR_PENDING_SECRET=replace_with_a_random_32plus_char_secret
TWO_FACTOR_PENDING_TTL=5m

TOTP_ISSUER=HRMS

# AES-256-GCM key for application-level field encryption (nationalId, bankAccount, twoFaSecret).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace_with_a_random_32byte_key

DOCUMENT_STORAGE_PATH=../../storage/documents
# Generate with: openssl rand -base64 48
DOCUMENT_URL_SECRET=replace_with_a_random_32plus_char_secret
DOCUMENT_URL_TTL=10m

PAYSLIP_STORAGE_PATH=../../storage/payslips
# Generate with: openssl rand -base64 48
PAYSLIP_URL_SECRET=replace_with_a_random_32plus_char_secret
PAYSLIP_URL_TTL=10m

CORS_ORIGINS=http://localhost:3000

# Auth-endpoint IP throttle limits, per 60s window (login, and
# password-reset/request + 2fa/verify respectively). 10/5 is the
# production-appropriate default this project's own DECISIONS.md
# documents. Bumped much higher on THIS machine's actual .env (not
# committed) because this project's own real-backend frontend
# integration test suite (apps/web) repeatedly logs into this same
# long-running dev API process — production's stricter values would
# throttle our own tests, not just attackers. Keep this file's defaults
# at the strict, production-realistic numbers; override locally instead
# of changing what a fresh clone starts from.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_STRICT_RATE_LIMIT=5

FRONTEND_URL=http://localhost:3000

# SMTP transport for the Notifications module. Dev default points at the
# local MailDev catcher (docker-compose service `maildev`, no auth needed
# — leave SMTP_USER/SMTP_PASSWORD blank). In production, replace with a
# real provider's SMTP credentials (Resend/Postmark/SES/Brevo/etc) — no
# code change needed, this is config-only. See DECISIONS.md.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=HRMS <no-reply@hrms.local>
