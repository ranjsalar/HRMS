generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime app connection — bound to the hrms_app role (RLS-enforced).
  url       = env("DATABASE_URL")
  // Used only by the Prisma CLI (migrate/introspect) — bound to the schema
  // owner role, which needs DDL + shadow-database privileges that hrms_app
  // deliberately does not have. See DECISIONS.md.
  directUrl = env("DATABASE_MIGRATE_URL")
}

// ── Tenancy & Auth ──────────────────────────────────────────────

model Company {
  id               String        @id @default(uuid())
  name             String
  city             String
  timezone         String        @default("Asia/Baghdad")
  localeDefault    String        @default("en") // en | ar | ku
  subscriptionPlan String        @default("trial")
  status           CompanyStatus @default(active)
  // Days treated as the weekend for working-day calculations (leave
  // requests), as JS Date.getUTCDay() values (0=Sun..6=Sat). Default is
  // Friday+Saturday — the common Kurdistan/Iraq workweek, NOT the Western
  // Mon-Fri assumption. Per-company because this genuinely varies by
  // employer. See DECISIONS.md.
  weekendDays      Int[]         @default([5, 6])
  // Which PayrollRegionRule set applies when this company has no
  // company-specific override for a given rule — see PayrollRulesService.
  // Company-level, not per-branch/per-employee: a judgment call, documented
  // in DECISIONS.md — revisit if a pilot company genuinely operates payroll
  // under both jurisdictions at once.
  payrollRegion    PayrollRegion @default(krg)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  users              User[]
  employees          Employee[]
  departments        Department[]
  branches           Branch[]
  documents          Document[]
  shifts             Shift[]
  attendanceRecords  AttendanceRecord[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payrollRegionRules PayrollRegionRule[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  auditLogs          AuditLog[]
  projects           Project[]
  projectMembers     ProjectMember[]
  tasks              Task[]
  taskTimeEntries    TaskTimeEntry[]
}

enum CompanyStatus {
  active
  suspended
  archived
}

model User {
  id                  String    @id @default(uuid())
  companyId           String? // null only for Super Admin
  company             Company?  @relation(fields: [companyId], references: [id])
  email               String
  passwordHash        String // argon2id
  role                RoleName
  locale              String    @default("en") // per-user setting
  twoFaSecret         String? // encrypted at rest
  twoFaEnabled        Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Not in the original schema — added for the "temp password, forced
  // change on first login" requirement (step 3 auth module); there was no
  // existing field to represent this state. See DECISIONS.md.
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee      Employee?
  refreshTokens RefreshToken[]
  permissions   RolePermission[]

  @@unique([companyId, email])
}

enum RoleName {
  superadmin
  company_admin
  manager
  employee
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model RolePermission {
  id        String          @id @default(uuid())
  companyId String
  role      RoleName
  module    String // "employees" | "attendance" | "leave" | "payroll" | ...
  action    String // "view" | "create" | "edit" | "delete" | "approve"
  scope     PermissionScope @default(all)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])

  @@unique([companyId, role, module, action, userId])
}

enum PermissionScope {
  all
  own_department
  self
}

// ── Org structure ───────────────────────────────────────────────

model Department {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  name               String
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DeptHierarchy", fields: [parentDepartmentId], references: [id])
  children           Department[] @relation("DeptHierarchy")
  employees          Employee[]   @relation("DepartmentEmployees")
  managedBy          Employee[]   @relation("DepartmentManagers")
}

model Branch {
  id                   String     @id @default(uuid())
  companyId            String
  company              Company    @relation(fields: [companyId], references: [id])
  name                 String
  city                 String
  // Geofence center + radius, configured per-branch (not per-company): a
  // company with multiple physical offices needs a different center point
  // per site, and Branch is the model that already represents "a physical
  // site." All three are optional together — a branch with no geofence
  // configured simply isn't geofence-checked (see AttendanceService: no
  // config -> withinGeofence stays null, never flagged). See DECISIONS.md.
  geofenceLat          Float?
  geofenceLng          Float?
  geofenceRadiusMeters Int?
  employees            Employee[]
}

model Employee {
  id                  String         @id @default(uuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id])
  fullName            String
  nationalId          String // ⚠ ciphertext — encrypted via field-encryption wrapper
  jobTitle            String
  departmentId        String?
  department          Department?    @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  branchId            String?
  branch              Branch?        @relation(fields: [branchId], references: [id])
  managedDepartmentId String?
  managedDepartment   Department?    @relation("DepartmentManagers", fields: [managedDepartmentId], references: [id])
  hireDate            DateTime
  salaryBase          Decimal        @db.Decimal(14, 2)
  currency            String         @default("IQD") // IQD | USD
  bankAccount         String? // ⚠ ciphertext — encrypted via field-encryption wrapper
  status              EmployeeStatus @default(active)
  // Contact-info fields — the ONLY fields a self-scoped employee may ever
  // edit on their own record (see EmployeesService.update() and
  // DECISIONS.md, step 9.4). Plaintext, not encrypted like
  // nationalId/bankAccount: comparable sensitivity to User.email, which is
  // also stored plaintext — a phone number/address isn't a national ID or
  // bank detail.
  phone                  String?
  address                String?
  emergencyContactName   String?
  emergencyContactPhone  String?

  documents          Document[]
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payslips           Payslip[]
  projectMemberships ProjectMember[]
  assignedTasks      Task[]
  taskTimeEntries    TaskTimeEntry[]
}

enum EmployeeStatus {
  active
  on_leave
  terminated
}

// ── Documents ────────────────────────────────────────────────────

model Document {
  id         String       @id @default(uuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id])
  type       DocumentType
  fileUrl    String // signed, expiring URL — never a public path
  expiryDate DateTime?
  uploadedAt DateTime     @default(now())
}

enum DocumentType {
  contract
  id
  passport
  certificate
}

// ── Attendance ───────────────────────────────────────────────────

model Shift {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  startTime String
  endTime   String
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  clockIn        DateTime
  clockOut       DateTime?
  clockInLat     Float?
  clockInLng     Float?
  clockOutLat    Float?
  clockOutLng    Float?
  withinGeofence Boolean?
  source         AttendanceSource @default(web)
  overriddenBy   String?
  note           String?
}

enum AttendanceSource {
  web
  mobile
  admin_override
}

// ── Leave ────────────────────────────────────────────────────────

model LeaveType {
  id               String  @id @default(uuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id])
  name             String
  daysPerYear      Int
  requiresApproval Boolean @default(true)
  // Whether time off under this type is paid. Unpaid days within a payroll
  // period reduce that period's gross pay proportionally — see
  // PayrollService / DECISIONS.md. Defaults true so every LeaveType
  // created before this field existed keeps its current (paid) behavior.
  paid             Boolean @default(true)
  // Deactivate, never hard-delete, once any LeaveRequest/LeaveBalance
  // history exists against it — same reasoning as Employee soft-delete.
  active           Boolean @default(true)

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
}

model LeaveRequest {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  status      LeaveStatus @default(pending)
  // Working days actually deducted from LeaveBalance at approval time —
  // stored, not recomputed later, so a reject-after-approval restores
  // EXACTLY what was deducted even if the Holiday table changes in the
  // meantime. Null until approved (pending/rejected-while-pending/
  // cancelled requests never touched a balance). See DECISIONS.md.
  workingDays Decimal?    @db.Decimal(5, 2)
  approvedBy  String?
  rejectedBy  String?
  reason      String?
  // The rejecting manager/admin's OWN reason, distinct from `reason`
  // above (the employee's own reason for requesting, set at submit
  // time) — added for the leave-decision notification email, which
  // needs to be able to tell an employee WHY their request was rejected
  // when one was given. Optional: rejecting with no explanation is still
  // a valid action. See DECISIONS.md.
  rejectionReason String?
  createdAt   DateTime    @default(now())
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

model LeaveBalance {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  balance     Decimal   @db.Decimal(6, 2)

  @@unique([employeeId, leaveTypeId, year])
}

// ── Payroll ──────────────────────────────────────────────────────

enum PayrollRegion {
  krg
  federal_iraq
}

// The rules engine the Project Plan calls for ("a rules engine per region
// ... rather than hardcoded formulas"): one row per (company, region) or
// per (null, region) for the system-wide default an admin can override.
// `companyId: null` rows are the seeded KRG/federal-Iraq defaults — see
// DECISIONS.md for why these are PLACEHOLDER rates pending real legal/
// accounting review, not production-accurate law. Lookup always prefers a
// company-specific row over the system default for that region (see
// PayrollRulesService). Not enforced as a DB-level "exactly one default
// per region" constraint — the composite unique below only actually
// constrains company-specific rows (Postgres treats NULL companyId values
// as mutually distinct for uniqueness), so avoiding duplicate system
// defaults is a seed-script discipline, same trust boundary as Holiday's
// `companyId: null` rows already carry.
model PayrollRegionRule {
  id        String        @id @default(uuid())
  companyId String?
  company   Company?      @relation(fields: [companyId], references: [id])
  region    PayrollRegion

  // Overtime pay = hourlyRate * overtimeMultiplier * overtimeHours, where
  // hourlyRate = Employee.salaryBase / standardMonthlyHours.
  overtimeMultiplier   Decimal @db.Decimal(4, 2)
  standardMonthlyHours Int

  // Unpaid-leave deduction = dailyRate * unpaidWorkingDays, where
  // dailyRate = Employee.salaryBase / standardWorkingDaysPerMonth.
  // Deliberately a separate configurable figure from standardMonthlyHours
  // / 8 — the two conventions (an hours-based standard for overtime, a
  // days-based standard for daily-rate deductions) don't have to agree,
  // and forcing them to would be inventing a constraint the Project Plan
  // never asked for.
  standardWorkingDaysPerMonth Int

  // Employee-side social security contribution, percent of gross pay
  // (after overtime, before tax) — see calculate-payslip.ts for the exact
  // pipeline order.
  socialSecurityEmployeePct Decimal @db.Decimal(5, 2)

  // false until someone with real regional payroll/legal authority
  // confirms this rule's figures against current law. Defaults false so
  // every rule — including the seeded system defaults, see
  // database/seeds/payroll-rules.ts — starts unverified. A PayrollRun
  // cannot be finalized against an unverified rule without an explicit,
  // audited company_admin acknowledgment — see
  // PayrollRunsService.finalize and DECISIONS.md.
  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxBrackets PayrollTaxBracket[]

  @@unique([companyId, region])
}

// Progressive tax bands for a PayrollRegionRule, lowest bracket first
// (`order` ascending). `upToAmount: null` marks the top, unbounded
// bracket. companyId is denormalized from the parent rule purely so RLS
// can filter this table directly by column (same convention every other
// tenant-scoped table in this schema follows — no policy here needs a
// subquery/join to the parent).
model PayrollTaxBracket {
  id          String            @id @default(uuid())
  companyId   String?
  ruleId      String
  rule        PayrollRegionRule @relation(fields: [ruleId], references: [id])
  order       Int
  upToAmount  Decimal?          @db.Decimal(14, 2)
  ratePercent Decimal           @db.Decimal(5, 2)
  // Mirrors the parent rule's `verified` at write time (both are always
  // replaced together in PayrollRulesService.upsertCompanyRule) — kept on
  // this table too, per explicit instruction, rather than relying solely
  // on a join to the parent.
  verified    Boolean           @default(false)

  @@unique([ruleId, order])
}

model PayrollRun {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(draft)
  createdBy   String?
  finalizedBy String?
  finalizedAt DateTime?

  payslips Payslip[]
}

enum PayrollRunStatus {
  draft
  processing
  finalized
}

model Payslip {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  gross        Decimal    @db.Decimal(14, 2)
  deductions   Decimal    @db.Decimal(14, 2)
  net          Decimal    @db.Decimal(14, 2)
  currency     String     @default("IQD")
  // Full computation trail (base salary, overtime hours/pay, unpaid-leave
  // days/deduction, social security, tax, region) — transparency/debugging
  // without normalizing every intermediate figure into its own column,
  // and without complicating the immutability story (one row to freeze,
  // not several). See DECISIONS.md.
  breakdown    Json?
  pdfUrl       String?
  generatedAt  DateTime?
}

// ── Holiday calendar ───────────────────────────────────────────────

model Holiday {
  id        String   @id @default(uuid())
  companyId String? // null = system-wide default calendar, else company override
  name      String
  date      DateTime
  recurring Boolean  @default(false) // false for lunar-based (Eid) — reseeded yearly
}

// ── Audit ────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  timestamp DateTime @default(now())
}

// ── Projects / Task Management ──────────────────────────────────────
// ERP module #2, per ERP-Master-Plan.md — see Projects-Module-Plan.md for
// the full design (RBAC model, out-of-scope list, why TaskTimeEntry is a
// manual log rather than a reuse of AttendanceRecord's clock-in/out +
// geofence shape). Every model here follows the exact same companyId +
// RLS pattern as every table above; Task/ProjectMember reference Employee
// directly, never a parallel "team member" concept.

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
}

model Project {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  name        String
  description String?
  status      ProjectStatus @default(planning)
  startDate   DateTime?
  dueDate     DateTime?
  // Plain string, no relation — same "who did this" convention as
  // LeaveRequest.approvedBy / PayrollRun.finalizedBy: an audit-adjacent
  // fact, not a query join point.
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members ProjectMember[]
  tasks   Task[]
}

model ProjectMember {
  id         String   @id @default(uuid())
  // Denormalized onto this row (not just reachable via Project) because
  // RLS policies always compare a column on the row itself — every
  // other tenant-owned table in this schema does the same, even ones
  // that could theoretically derive companyId through a join.
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([projectId, employeeId])
}

model Task {
  id          String     @id @default(uuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  title       String
  description String?
  status      TaskStatus @default(todo)
  assigneeId  String?
  assignee    Employee?  @relation(fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  timeEntries TaskTimeEntry[]
}

model TaskTimeEntry {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  hours      Decimal  @db.Decimal(5, 2)
  note       String?
  createdAt  DateTime @default(now())
}
