# ── General ──────────────────────────────────────────────────────
NODE_ENV=development

# ── Postgres (docker-compose) ───────────────────────────────────
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_dev_password
POSTGRES_DB=hrms

# ── API ──────────────────────────────────────────────────────────
PORT=3001

# ── Database roles ──────────────────────────────────────────────
# Three distinct Postgres roles, deliberately not interchangeable. See
# DECISIONS.md ("Postgres role separation for RLS to have teeth") for why:
# in short, the table *owner* always bypasses RLS regardless of policies,
# so the owner role can never be used for tenant runtime traffic.
#
#   hrms             — schema owner (POSTGRES_USER below). Used ONLY by the
#                       Prisma CLI (migrate/introspect) via DATABASE_MIGRATE_URL.
#                       Never used by the running application.
#   hrms_app          — regular tenant runtime role. NOT the table owner, NOT
#                       BYPASSRLS, so `tenant_isolation` policies actually
#                       apply to it. Used for DATABASE_URL — all normal
#                       request traffic.
#   hrms_superadmin    — BYPASSRLS role, used only for the dedicated Super
#                       Admin connection after the authenticated user's role
#                       is confirmed superadmin server-side.
#   hrms_auth          — narrowly-scoped role for the pre-authentication
#                       login lookup (email isn't known-tenant yet, so
#                       app.current_company_id can't be set). Column-level
#                       GRANT SELECT/UPDATE on specific User columns only,
#                       no grant at all on any other table. See
#                       DECISIONS.md ("Least-privilege login role vs. Super
#                       Admin connection").

# Prisma CLI only (migrations, shadow DB) — owner role, DDL rights.
DATABASE_MIGRATE_URL=postgresql://hrms:hrms_dev_password@postgres:5432/hrms?schema=public

# Regular tenant traffic — RLS-enforced role, never bypasses tenant isolation.
DATABASE_URL=postgresql://hrms_app:hrms_app_dev_password@postgres:5432/hrms?schema=public

# Super Admin only — separate Postgres role with BYPASSRLS, used exclusively
# for cross-tenant queries after the authenticated user's role is confirmed
# superadmin server-side. Never used for regular tenant requests.
DATABASE_SUPERADMIN_URL=postgresql://hrms_superadmin:hrms_superadmin_dev_password@postgres:5432/hrms?schema=public

# Login/lockout lookups only — see hrms_auth note above. Never used for any
# other query.
DATABASE_AUTH_URL=postgresql://hrms_auth:hrms_auth_dev_password@postgres:5432/hrms?schema=public

# Passwords used by the post-migration role-bootstrap script
# (src/database/seeds/bootstrap-roles.ts) to set hrms_app's, hrms_superadmin's,
# and hrms_auth's login passwords — kept out of the migration SQL itself
# since that file is committed to git.
HRMS_APP_DB_PASSWORD=hrms_app_dev_password
HRMS_SUPERADMIN_DB_PASSWORD=hrms_superadmin_dev_password
HRMS_AUTH_DB_PASSWORD=hrms_auth_dev_password

REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_random_32plus_char_secret
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque random values, hashed before storage in
# RefreshToken.tokenHash — not JWTs, so there is no JWT_REFRESH_SECRET.
JWT_REFRESH_TTL=7d

# Signs short-lived password-reset tokens (stateless, not stored in the DB
# — see DECISIONS.md for the single-use-enforcement trade-off this implies).
# Generate with: openssl rand -base64 48
PASSWORD_RESET_SECRET=replace_with_a_random_32plus_char_secret
PASSWORD_RESET_TTL=30m

# Signs short-lived tokens issued between password verification and
# completed 2FA (a distinct secret from JWT_ACCESS_SECRET on purpose — see
# DECISIONS.md). Generate with: openssl rand -base64 48
TWO_FACTOR_PENDING_SECRET=replace_with_a_random_32plus_char_secret
TWO_FACTOR_PENDING_TTL=5m

# Shown as the issuer name in authenticator apps during TOTP enrollment.
TOTP_ISSUER=HRMS

# AES-256-GCM key for application-level field encryption (nationalId, bankAccount, twoFaSecret).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace_with_a_random_32byte_key

# Local disk root for uploaded documents — outside the web root, never
# served statically (see DocumentsService / LocalDiskStorageService).
# Relative to apps/api's process cwd either in Docker or on the host.
DOCUMENT_STORAGE_PATH=../../storage/documents
# Signs short-lived document-download "signed URLs". Generate with: openssl rand -base64 48
DOCUMENT_URL_SECRET=replace_with_a_random_32plus_char_secret
DOCUMENT_URL_TTL=10m

# Local disk root for generated payslip PDFs — same rules as documents,
# kept as its own path/secret (distinct retention/sensitivity concern).
PAYSLIP_STORAGE_PATH=../../storage/payslips
# Generate with: openssl rand -base64 48
PAYSLIP_URL_SECRET=replace_with_a_random_32plus_char_secret
PAYSLIP_URL_TTL=10m

# Comma-separated list of allowed frontend origins (never * in production).
CORS_ORIGINS=http://localhost:3000

# ── Web ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
